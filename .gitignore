# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS junk ---
# Note: root desktop.ini is intentional EXPC project-folder presentation
# metadata (pairs with assets/icon.ico), not disposable OS junk -- it is
# tracked, not ignored. Subdirectory desktop.ini files (if any ever
# appear, e.g. from Explorer folder customization elsewhere in the tree)
# are still OS junk; this repository has none today.
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# --- Build / release artifacts ---
build/
dist/*
!dist/.gitkeep
*.spec

# --- Staging / download temp dirs ---
staging/
downloads/
tmp/
temp/

# --- SQLite runtime files ---
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.sqlite.tmp

# --- Generated release packages ---
*.zip
*.tar.gz
*.7z

# --- Logs ---
*.log
logs/

# --- Test cache ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
